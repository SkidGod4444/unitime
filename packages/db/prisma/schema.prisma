// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum CourseType {
  CORE
  OPEN_ELECTIVE
  VOCATIONAL_ELECTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum CourseEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseSemester {
  FIRST_SEMESTER
  SECOND_SEMESTER
  THIRD_SEMESTER
  FOURTH_SEMESTER
  FIFTH_SEMESTER
  SIXTH_SEMESTER
  SEVENTH_SEMESTER
  EIGHTH_SEMESTER
  NINTH_SEMESTER
  TENTH_SEMESTER
}

enum CourseClassType {
  LECTURE
  LAB
  TUTORIAL
}

model Courses {
  id                  String                @id @default(uuid())
  code                String
  name                String
  credit              Float                 @default(0.0)
  description         String?
  professorId         String?
  type                CourseType            @default(CORE)
  status              CourseStatus          @default(ACTIVE)
  enrollmentEnabled   Boolean               @default(true) @map("enrollment_enabled")
  semester            CourseSemester        @default(FIRST_SEMESTER)
  classType           CourseClassType       @default(LECTURE)
  users               UserCourse[]
  timetable           Timetable[]
  attendanceQRSession AttendanceQRSession[]
  attendanceSummary   AttendanceSummary[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  organizationId      String?               @map("organization_id")
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("courses")
}

enum UserRole {
  STUDENT
  PROFESSOR
  ADMIN
  REPRESENTATIVE
  COUNSELOR
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  ATTENDANCE
  SYSTEM
}

enum HistoryLogType {
  ATTENDANCE
  SYSTEM
}

model Notification {
  id              String           @id @default(uuid())
  title           String
  body            String
  type            NotificationType
  readBy          String[]         @default([]) @map("read_by") // Array of user IDs who have read this
  userId          String?          @map("user_id")
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?          @map("organization_id")
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionUrl       String?          @map("action_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("notifications")
}

model HistoryLog {
  id              String         @id @default(uuid())
  title           String
  description     String
  type            HistoryLogType
  userId          String?        @map("user_id")
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?        @map("organization_id")
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("history_logs")
}

model User {
  id                   String                @id
  name                 String
  email                String
  emailVerified        Boolean               @default(false)
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  banned               Boolean?              @default(false)
  banReason            String?
  banExpires           DateTime?
  courses              UserCourse[]
  timetables           UserTimetable[]
  attendanceQRSessions AttendanceQRSession[]
  attendances          AttendanceLogs[]
  attendanceSummary    AttendanceSummary[]
  studentProfile       StudentProfile?
  alarms               Alarm[]
  notifications        Notification[]
  historyLogs          HistoryLog[]
  coordinates          String?               @map("coordinates") // For geofencing, format: "latitude,longitude"
  expoPushToken        String?               @map("expo_push_token") // For push notifications
  isOnboarded          Boolean               @default(false) @map("is_onboarded") // To track if user has completed onboarding
  role                 UserRole              @default(STUDENT)
  status               UserStatus            @default(ACTIVE)

  @@unique([email])
  @@map("user")
}

// Junction table for many-to-many relationship between User and Course
model UserCourse {
  id         String                 @id @default(uuid())
  userId     String                 @map("user_id")
  courseId   String                 @map("course_id")
  status     CourseEnrollmentStatus @default(PENDING)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Courses                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime               @default(now()) @map("enrolled_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("user_courses")
}

// Junction table for many-to-many relationship between User and Timetable
model UserTimetable {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  timetableId String    @map("timetable_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, timetableId])
  @@map("user_timetable")
}

enum CourseDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id        String          @id @default(uuid())
  courseId  String          @map("course_id")
  course    Courses         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  day       CourseDay       @default(MONDAY)
  startTime DateTime        @map("start_time")
  endTime   DateTime        @map("end_time")
  location  String?
  users     UserTimetable[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([courseId, day, startTime, endTime])
  @@index([day])
  @@map("timetable")
}

enum AttendanceQRStatus {
  ACTIVE
  INACTIVE
}

model AttendanceQRSession {
  id          String             @id @default(uuid())
  courseId    String             @map("course_id")
  createdBy   String             @map("created_by")
  user        User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  course      Courses            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      AttendanceQRStatus @default(ACTIVE)
  markedUsers String[]           @default([]) @map("marked_users") // Array of user IDs who have marked attendance
  startTime   DateTime           @map("start_time")
  endTime     DateTime           @map("end_time")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([courseId])
  @@index([status])
  @@index([courseId, status])
  @@map("attendance_qr_sessions")
}

enum AttendanceSessionType {
  QR_SESSION
  MANUAL_SESSION
  TAP_SESSION
}

model AttendanceLogs {
  id          String                @id @default(uuid())
  sessionId   String                @map("session_id")
  sessionType AttendanceSessionType @default(QR_SESSION) @map("session_type")
  userId      String                @map("user_id")
  markedAt    DateTime              @default(now()) @map("marked_at")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@map("attendance_logs")
}

model AttendanceSummary {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  courseId   String   @map("course_id")
  attended   Int      @default(0)
  total      Int      @default(0)
  percentage Float    @default(0.0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@map("attendance_summary")
}

model StudentProfile {
  admissionNumber  String          @id @unique
  enrollmentNumber String?         @unique
  studentEmail     String?         @unique
  contactNumber    String?         @unique
  userId           String          @unique @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String
  course           String
  yearOfStudy      Int
  semester         CourseSemester?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  organizationId   String          @map("organization_id")
  organization     Organization    @relation(fields: [organizationId], references: [id])

  @@map("student_profiles")
}

model Organization {
  id             String           @id @default(uuid())
  departmentName String           @map("department_name")
  courseName     String           @map("course_name")
  semester       CourseSemester   @map("semester")
  section        Int              @unique @map("section")
  students       StudentProfile[]
  courses        Courses[]
  notifications  Notification[]
  historyLogs    HistoryLog[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("organizations")
}

model Alarm {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  courseCode  String   @map("course_code")
  color       String   @default("#6366f1")
  time        String   // "HH:MM" 24-hour
  days        Int[]    // 0=Sun…6=Sat
  leadMinutes Int      @default(15) @map("lead_minutes")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("alarms")
}
